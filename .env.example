HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/varka.sqlite
# Set a strong shared shop password before exposing the app to a network.
# Required with NODE_ENV=production; never put this value in frontend files.
APP_PASSWORD=
# First startup: this account is provisioned as owner with APP_PASSWORD as its code.
# Alternatively provision accounts using npm run user:add before production startup.
OWNER_EMAIL=
# Set to 1 only behind exactly one trusted HTTPS reverse proxy.
TRUST_PROXY=0
# For the optional Docker Compose + Caddy HTTPS deployment:
DOMAIN=inventory.example.com
# Optional delivery. Defaults off even if reports were enabled in the spreadsheet.
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
